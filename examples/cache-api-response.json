{
	"name": "Cache an API response with Artefaktum",
	"nodes": [
		{
			"parameters": {},
			"id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
			"name": "Manual Trigger",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"url": "https://api.open-meteo.com/v1/forecast?latitude=54.69&longitude=25.28&current=temperature_2m",
				"options": {
					"response": {
						"response": {
							"responseFormat": "json"
						}
					}
				}
			},
			"id": "e5a1b1a4-1f0a-4c8a-9d2e-2e6b2c9a1b2c",
			"name": "HTTP Request",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [220, 0]
		},
		{
			"parameters": {
				"resource": "artifact",
				"operation": "getOrUpload",
				"project": {
					"__rl": true,
					"mode": "slug",
					"value": "default"
				},
				"externalKey": "=weather:vilnius:{{ $now.toFormat('yyyy-LL-dd') }}",
				"maxAgeSeconds": 3600,
				"inputDataSource": "text",
				"content": "={{ JSON.stringify($json) }}",
				"contentType": "application/json",
				"title": "=Vilnius weather {{ $now.toFormat('yyyy-LL-dd') }}",
				"uploadOptions": {
					"tags": "weather, vilnius"
				}
			},
			"id": "f6b2c2b5-2a1b-4d9b-8e3f-3f7c3d0a2c3d",
			"name": "Artefaktum",
			"type": "n8n-nodes-artefaktum.artefaktum",
			"typeVersion": 1,
			"position": [440, 0],
			"credentials": {
				"artefaktumApi": {
					"id": "1",
					"name": "Artefaktum API"
				}
			}
		}
	],
	"connections": {
		"Manual Trigger": {
			"main": [
				[
					{
						"node": "HTTP Request",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"HTTP Request": {
			"main": [
				[
					{
						"node": "Artefaktum",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {}
}
